{
  "name": "listingsapi-js",
  "version": "0.3.2",
  "description": "Node.js SDK for listingsAPI — listings, reviews, posts, and analytics for local marketing",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node test-integration.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "listingsapi",
    "sdk",
    "api",
    "listings",
    "reviews",
    "posts",
    "local-seo"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/listings-api/listingsapi-nodejs-sdk.git"
  },
  "homepage": "https://docs.listingsapi.com/sdks/node",
  "author": "listingsAPI <support@listingsapi.com>"
}
